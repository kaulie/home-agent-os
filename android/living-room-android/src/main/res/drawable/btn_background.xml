<?xml version="1.0" encoding="utf-8"?>
<!-- Solid rounded rect with strong state contrast for TV / mouse hover. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/btn_bg_pressed" />
            <corners android:radius="6dp" />
            <stroke
                android:width="2dp"
                android:color="@color/btn_text_on_accent" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/btn_bg_focused" />
            <corners android:radius="6dp" />
            <stroke
                android:width="2dp"
                android:color="@color/btn_text_on_accent" />
        </shape>
    </item>
    <item android:state_hovered="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/btn_bg_hovered" />
            <corners android:radius="6dp" />
            <stroke
                android:width="2dp"
                android:color="@color/accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/btn_bg" />
            <corners android:radius="6dp" />
            <stroke
                android:width="1dp"
                android:color="#3A4458" />
        </shape>
    </item>
</selector>
