<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="idle"
            android:textIsSelectable="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="用户意图"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="文本直接发送；语音先本机转写，再 POST 到服务器"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/intentText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="3"
            android:gravity="top"
            android:hint="输入指令，例如：帮我拍张照"
            android:inputType="textMultiLine" />

        <TextView
            android:id="@+id/intentSourceHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="来源：文本"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnVoice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="开始录音" />

            <Button
                android:id="@+id/btnSendIntent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="发出指令" />

            <Button
                android:id="@+id/btnClearIntent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="清空" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="意图物流图"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/journeyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="120dp"
            android:padding="8dp"
            android:background="#11000000"
            android:text="（暂无活跃意图）"
            android:textIsSelectable="true"
            android:textSize="12sp"
            android:typeface="monospace" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="目标 Wi‑Fi（如 GoPro）"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/goproSsid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="SSID"
            android:inputType="text" />

        <EditText
            android:id="@+id/goproPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="密码"
            android:inputType="textPassword" />

        <CheckBox
            android:id="@+id/chkShowPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="显示密码" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSaveWifi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="保存" />

            <Button
                android:id="@+id/btnPermissions"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="权限" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="「加入」弹连接到设备（进程绑定，状态栏可能不变）。要状态栏切换请用「用系统设置加入」。"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnWifiJoin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="加入目标 Wi‑Fi" />

        <Button
            android:id="@+id/btnWifiSystemAdd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="用系统设置加入（可见切网）" />

        <Button
            android:id="@+id/btnWifiLeave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="离开并回默认网络" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Edge 注册 / 心跳"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="先 POST /edge-register 拿 edgeId 并落盘；心跳用已缓存 edgeId。与「启动 Agent」轮询独立。"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRegister"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="注册" />

            <Button
                android:id="@+id/btnHeartbeat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="心跳" />
        </LinearLayout>

        <Button
            android:id="@+id/btnClearEdgeId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/clear_local_edge_id" />

        <CheckBox
            android:id="@+id/chkAutoStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/auto_start_on_boot" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnStartAgent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="启动 Agent" />

            <Button
                android:id="@+id/btnStopAgent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="停止 Agent" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="日志"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="160dp"
            android:padding="8dp"
            android:background="#11000000"
            android:textIsSelectable="true"
            android:textSize="12sp"
            android:typeface="monospace" />
    </LinearLayout>
</ScrollView>
