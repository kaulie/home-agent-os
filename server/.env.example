# Copy to server/.env (gitignored). Never commit real keys.
ARK_API_KEY=
# Optional; defaults match production Ark Beijing chat completions.
# ARK_MODEL_ID=ep-20260712174403-5jcgs
# ARK_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
# BRAIN_DB_PATH=/absolute/path/to/brain.sqlite3
# BRAIN_UPLOAD_DIR=/absolute/path/to/uploads/gopro
# BRAIN_SKIP_LLM_WORKER=1
# BRAIN_LOG_DIR=/absolute/path/to/llm_logs
# Which Brain this process is. lan = local/dev (default). cloud = cloud-server.
# If unset: path /root/chat-gateway → cloud, otherwise lan.
# BRAIN_ORIGIN=lan
# Cloud OCR HTTP service (ocr-service/, bind 127.0.0.1 only). Not on LAN / Mac Edge.
# OCR_SERVICE_URL=http://127.0.0.1:9188
# Shadow Qwen planner (local Brain → cloud :8090). Never used for enqueue.
# Enable with QWEN_PLANNER=1 (off unless set). Doubao remains the executing planner.
# QWEN_PLANNER=1
# QWEN_PLANNER_URL=http://115.190.153.53:8090/chat
# QWEN_PLANNER_MODEL=Qwen2.5-0.5B-Instruct
# QWEN_PLANNER_TIMEOUT_SEC=180
