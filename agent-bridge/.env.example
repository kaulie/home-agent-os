# Cursor API key (Dashboard → Integrations). Optional if `cursor-agent` is logged in.
# CURSOR_API_KEY=cursor_...

# HTTP bind
AGENT_BRIDGE_HOST=127.0.0.1
AGENT_BRIDGE_PORT=9540

# Agent working directory (default: smart_home_control repo root)
# AGENT_BRIDGE_CWD=/Users/gaolei/Projects/smart_home_control

# Persisted state (agent_id, run history)
# AGENT_BRIDGE_DATA_DIR=/Users/gaolei/Projects/smart_home_control/agent-bridge/data

# Cursor model for local agent
AGENT_BRIDGE_MODEL=composer-2.5

# Optional bearer token for HTTP API (recommended if exposing beyond localhost)
# AGENT_BRIDGE_TOKEN=change-me

# Brain URL for downloading Dev Task attachments (usually cloud Brain)
# AGENT_BRIDGE_BRAIN_URL=http://115.190.153.53:9527
# AGENT_BRIDGE_BRAIN_ADMIN_TOKEN=your-brain-admin-token
