# ========= Python 虚拟环境、编译缓存（最大token消耗源） =========
**/.venv/**
**/venv/**
**/__pycache__/**
*.pyc
*.pyo
*.pyd
**/.pytest_cache/**
**/.coverage/**

# ========= Git版本控制，不要喂给AI =========
**/.git/**

# ========= 日志、抓包导出文件、临时文件 =========
*.log
*.har
*.tmp
**/logs/**

# ========= 密钥环境文件，禁止Cline读取，防止泄露key =========
.env
.env.*

# ========= Mac系统垃圾文件 =========
.DS_Store

# ========= VSCode 本地工作区配置 =========
**/.vscode/**

# ========= 构建输出、数据文件 =========
**/dist/**
**/build/**
*.sqlite
*.db

