# Brain base URL (no trailing slash)
MAC_EDGE_BRAIN_URL=http://115.190.153.53:9527

# Loop interval seconds (register / heartbeat / pull)
MAC_EDGE_INTERVAL_SEC=3

# Identity (optional overrides)
MAC_EDGE_CLIENT_HINT=living-room-mac
MAC_EDGE_DISPLAY_NAME=客厅 · Mac Edge
MAC_EDGE_DEVICE_TYPE=mac
MAC_EDGE_ROOM=living-room
MAC_EDGE_APP_VERSION=0.3.0

# Where edge_id.json is stored (default: ./data next to project root)
# MAC_EDGE_DATA_DIR=/Users/gaolei/devspace/home-agent-mac-edge-runtime/data

# External Cast HTTP service (independent process). Plugin does:
#   GET {MAC_EDGE_CAST_DISPLAY_URL}?url={photo_url}
MAC_EDGE_CAST_DISPLAY_URL=http://127.0.0.1:9095/endpoint/display
# Advertise display.photo only when Cast HTTP is listening (laptop :9095).
# home-server has no Cast process — leave unset (probe) or set 0.
# MAC_EDGE_ADVERTISE_CAST=1

# Which Mac registers which capabilities (Brain heartbeat):
#   laptop (default) — query / notify / vision / Cast；不注册 GoPro / 客厅灯
#   home-server      — gopro.camera（需 MAC_EDGE_GOPRO_SSID）+ livingroom.ceiling_light
# MAC_EDGE_ROLE=laptop
# Optional extra filter (home-server defaults to gopro.camera,livingroom.ceiling_light):
# MAC_EDGE_SERVICE_WHITELIST=gopro.camera,livingroom.ceiling_light

# TTS backend: say (default, local/low-latency) | edge (Microsoft edge-tts)
# MAC_EDGE_TTS_BACKEND=say
# Optional edge-tts voice when MAC_EDGE_TTS_BACKEND=edge
# MAC_EDGE_TTS_VOICE=zh-CN-YunxiNeural

# --- vision.perceive / vision.ask (Edge-local; pluggable providers) ---
# vision.ask 与 perceive 共用下列变量（同一视觉模型）；prompt/schema 各自独立。
# Prerequisite for default ark provider:
#   pip install --upgrade "volcengine-python-sdk[ark]"
# MAC_EDGE_VISION_PROVIDER=ark          # ark|openai (default ark = 火山方舟 SDK Responses)
# MAC_EDGE_VISION_API_BASE=https://ark.cn-beijing.volces.com/api/v3
# MAC_EDGE_VISION_API_KEY=              # or ARK_API_KEY
# MAC_EDGE_VISION_MODEL=ep-xxxxxxxx   # 方舟推理接入点 ID，或模型名
# # Switch example (OpenAI-compatible chat vision):
# # MAC_EDGE_VISION_PROVIDER=openai
# # MAC_EDGE_VISION_API_BASE=https://api.openai.com/v1
# # MAC_EDGE_VISION_MODEL=gpt-4o-mini

# --- query.content (Edge-local; independent of vision.perceive) ---
# MAC_EDGE_QUERY_PROVIDER=ark           # ark|openai (default ark)
# MAC_EDGE_QUERY_API_BASE=https://ark.cn-beijing.volces.com/api/v3
# MAC_EDGE_QUERY_API_KEY=               # or ARK_API_KEY
# MAC_EDGE_QUERY_MODEL=ep-xxxxxxxx      # 文本模型 / 接入点
# MAC_EDGE_QUERY_IMAGE_MODEL=ep-20260814163146-9nwqb
# Read timeout for Ark /responses and images.generate (connect stays 20s, no SDK retries).
# Do not reuse Cast's 60s — a float timeout collapses Ark read to 60s × 3 retries ≈ 183s hang.
# MAC_EDGE_QUERY_TIMEOUT_SEC=90

# --- gopro.camera / camera.capture (silent Wi-Fi switch) ---
# Advertised only when MAC_EDGE_GOPRO_SSID is set (home-server). Leave unset on laptops.
# MAC_EDGE_GOPRO_SSID=GoProHero4xxxxx
# MAC_EDGE_GOPRO_PASSWORD=xxxxxxxx
# MAC_EDGE_WIFI_DEVICE=en0              # optional; auto-detect Wi-Fi port
# MAC_EDGE_HOME_WIFI_SSID=              # optional; default = SSID before join
# MAC_EDGE_HOME_WIFI_PASSWORD=          # optional if home net already preferred
# Hold after restore in case macOS auto-joins the GoPro AP (preferred-network bounce). Default 1s.
# MAC_EDGE_WIFI_HOLD_SEC=1
# Faster restore: System Settings → Wi-Fi → Known Networks → GoPro SSID → Auto-Join Off.
# MAC_EDGE_GOPRO_HOST=http://10.5.5.9
# MAC_EDGE_PHOTO_UPLOAD_URL=http://115.190.153.53:9527/api/v1/photos/upload
# MAC_EDGE_PHOTO_PUBLIC_BASE=http://115.190.153.53:8080
# Upload dest for camera.capture: lan (default) | cloud
# MAC_EDGE_PHOTO_UPLOAD_DEST=lan
# LAN img-server (home-server :8080)
# MAC_EDGE_LAN_PHOTO_UPLOAD_URL=http://192.168.3.65:8080/api/v1/photos/upload
# MAC_EDGE_LAN_PHOTO_PUBLIC_BASE=http://192.168.3.65:8080

# --- Runtime intranet ping monitor (not a Brain capability; default ON) ---
# MAC_EDGE_INTRANET_PING=1
# MAC_EDGE_INTRANET_PING_MODE=gateway   # gateway | targets | lan
# MAC_EDGE_INTRANET_PING_TARGETS=192.168.3.65,192.168.3.8   # required when mode=targets
# MAC_EDGE_INTRANET_PING_INTERVAL_SEC=5
# MAC_EDGE_INTRANET_PING_TIMEOUT_MS=1000
# MAC_EDGE_INTRANET_PING_DISCOVER_INTERVAL_SEC=300   # lan peer refresh
# MAC_EDGE_INTRANET_PING_STATS_INTERVAL_SEC=60
# MAC_EDGE_INTRANET_PING_LOG=/path/to/intranet_ping.log
