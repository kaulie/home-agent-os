# Brain base URL (no trailing slash). Same-machine LAN Brain is loopback.
# Dual-Brain JSON:
#   MAC_EDGE_BRAIN_URL='{"lan": "http://127.0.0.1:9527", "cloud": "http://115.190.153.53:9527"}'
# Quote the JSON so `source .env` works. Primary is lan. Legacy comma list:
#   MAC_EDGE_BRAIN_URLS=http://127.0.0.1:9527,http://115.190.153.53:9527
MAC_EDGE_BRAIN_URL='{"lan": "http://127.0.0.1:9527", "cloud": "http://115.190.153.53:9527"}'
# TV/DLNA 需要能打到本机的局域网 IPv4 时再设（默认自动探测，不要写死家用 IP）：
# MAC_EDGE_BRAIN_LAN_URL=

# Loop interval seconds (register / heartbeat / pull)
MAC_EDGE_INTERVAL_SEC=3

# Identity (optional overrides)
MAC_EDGE_CLIENT_HINT=living-room-mac
MAC_EDGE_DISPLAY_NAME=客厅 · Mac Edge
MAC_EDGE_DEVICE_TYPE=mac
MAC_EDGE_ROOM=living-room
MAC_EDGE_APP_VERSION=0.3.0

# Where edge_id.json is stored (default: ./data next to project root)
# MAC_EDGE_DATA_DIR=/Users/gaolei/devspace/home-agent-mac-edge-runtime/data

# External Cast HTTP service (independent process). Plugin does:
#   GET {MAC_EDGE_CAST_DISPLAY_URL}?url={photo_url}
MAC_EDGE_CAST_DISPLAY_URL=http://127.0.0.1:9095/endpoint/display
# Advertise display.photo only when Cast HTTP is listening (laptop :9095).
# home-server has no Cast process — leave unset (probe) or set 0.
# MAC_EDGE_ADVERTISE_CAST=1

# Which Mac registers which capabilities (Brain heartbeat):
#   laptop (default) — query / notify / vision / Cast / climate.set（需爱家账号）
#                     ；不注册 GoPro / 客厅灯
#   home-server      — gopro.camera + livingroom.ceiling_light + local.asset
# MAC_EDGE_ROLE=laptop
# Optional extra filter (home-server defaults to gopro.camera,livingroom.ceiling_light,local.asset):
# MAC_EDGE_SERVICE_WHITELIST=gopro.camera,livingroom.ceiling_light,local.asset

# TTS backend: say (default, local/low-latency) | edge (Microsoft edge-tts)
# MAC_EDGE_TTS_BACKEND=say
# Optional edge-tts voice when MAC_EDGE_TTS_BACKEND=edge
# MAC_EDGE_TTS_VOICE=zh-CN-YunxiNeural

# --- xiaodu.speaker (UPnP DLNA TTS on 小度音箱) ---
# MAC_EDGE_XIAODU_IP=                  # required to advertise xiaodu.speak (speaker's own IP)
# MAC_EDGE_XIAODU_HTTP_PORT=8000         # MP3 LAN HTTP port
# MAC_EDGE_XIAODU_PUBLIC_HOST=           # IPv4 Xiaodu can reach (default: auto-detect)
# MAC_EDGE_XIAODU_VOICE=zh-CN-XiaoxiaoNeural

# --- voice_test.run_trial (台灯语音控制实验，Phase 1 单次闭环) ---
# 拍照默认走 Brain → iPhone camera.capture（GoPro），不要用本机 FaceTime。
# MAC_EDGE_VOICE_TEST_CAPTURE=gopro
# MAC_EDGE_VOICE_TEST_ISSUER=edge-node-JzvEe287
# 播放时 USB 麦回录，确认扬声器真的出声（不是只看 afplay 退出码）
# MAC_EDGE_VOICE_TEST_CONFIRM_PLAYBACK=1
# MAC_EDGE_VOICE_TEST_MIC_DEVICE=  # 空则自动找 reSpeaker；否则 sounddevice 序号或名称
# MAC_EDGE_VOICE_TEST_PROFILE=/path/to/profile.yaml
# MAC_EDGE_VOICE_TEST_VOICE=Tingting
# MAC_EDGE_VOICE_TEST_SPEED=1.0
# MAC_EDGE_VOICE_TEST_VOLUME=0.8
# MAC_EDGE_VOICE_TEST_WAKE=小书小书
# MAC_EDGE_VOICE_TEST_COMMAND=打开台灯
# MAC_EDGE_VOICE_TEST_WAKE_PAUSE_MS=2000
# MAC_EDGE_VOICE_TEST_SETTLE_MS=1500
# MAC_EDGE_WEBCAM_DEVICE=0
# MAC_EDGE_VOICE_TEST_DIR=

# --- video.live_stream ingest (MPEG-TS over TCP; Console + Larix) ---
# MAC_EDGE_VIDEO_INGEST=1
# MAC_EDGE_VIDEO_INGEST_HTTP_PORT=8790
# MAC_EDGE_VIDEO_INGEST_LARIX_PORT=5004
# MAC_EDGE_VIDEO_INGEST_PREVIEW=0   # 1 = spawn ffplay window when a stream connects


# --- vision.perceive / vision.ask (Edge-local; pluggable providers) ---
# vision.ask 与 perceive 共用下列变量（同一视觉模型）；prompt/schema 各自独立。
# Prerequisite for default ark provider:
#   pip install --upgrade "volcengine-python-sdk[ark]"
# MAC_EDGE_VISION_PROVIDER=ark          # ark|openai (default ark = 火山方舟 SDK Responses)
# MAC_EDGE_VISION_API_BASE=https://ark.cn-beijing.volces.com/api/v3
# MAC_EDGE_VISION_API_KEY=              # or ARK_API_KEY
# MAC_EDGE_VISION_MODEL=ep-xxxxxxxx   # 方舟推理接入点 ID，或模型名
# # Switch example (OpenAI-compatible chat vision):
# # MAC_EDGE_VISION_PROVIDER=openai
# # MAC_EDGE_VISION_API_BASE=https://api.openai.com/v1
# # MAC_EDGE_VISION_MODEL=gpt-4o-mini

# --- query.content (Edge-local; independent of vision.perceive) ---
# MAC_EDGE_QUERY_PROVIDER=ark           # ark|openai (default ark)
# MAC_EDGE_QUERY_API_BASE=https://ark.cn-beijing.volces.com/api/v3
# MAC_EDGE_QUERY_API_KEY=               # or ARK_API_KEY
# MAC_EDGE_QUERY_MODEL=ep-xxxxxxxx      # 文本模型 / 接入点
# MAC_EDGE_QUERY_IMAGE_MODEL=ep-20260814163146-9nwqb
# Read timeout for Ark /responses and images.generate (connect stays 20s, no SDK retries).
# Do not reuse Cast's 60s — a float timeout collapses Ark read to 60s × 3 retries ≈ 183s hang.
# MAC_EDGE_QUERY_TIMEOUT_SEC=90
# Wall-clock cap per capability step (one-shot or one recurring beat). Default 300.
# MAC_EDGE_CAPABILITY_TIMEOUT_SEC=300

# --- search.images (文搜图: 网上实拍，不是 query.content 文生图) ---
# Provider: bing | openverse. 缺省：有 MAC_EDGE_BING_SEARCH_KEY 用 bing，否则 openverse。
# MAC_EDGE_IMAGE_SEARCH_PROVIDER=openverse
# Azure Bing Image Search v7（F1 每月 1000 次）。不要提交真实密钥。
# MAC_EDGE_BING_SEARCH_KEY=
# MAC_EDGE_BING_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/images/search
# Openverse（CC / 开放许可，默认无需密钥；请保留可识别 User-Agent）
# MAC_EDGE_OPENVERSE_ENDPOINT=https://api.openverse.org/v1/images/
# MAC_EDGE_OPENVERSE_USER_AGENT=
# MAC_EDGE_OPENVERSE_ACCESS_TOKEN=

# --- climate.set (Hisense 爱家 cloud; laptop / 本机) ---
# Advertised only when both username and password are set. Never commit real values.
# MAC_EDGE_HISENSE_USERNAME=
# MAC_EDGE_HISENSE_PASSWORD=
# MAC_EDGE_HISENSE_HOME_ID=            # optional; required if more than one home
# Preferred: bind BOTH units on this Mac (placeholder ids — never commit real secrets):
# MAC_EDGE_HISENSE_DEVICES=[{"device_id":"YOUR_LIVING_ROOM_DEVICE_ID","label":"客厅空调"},{"device_id":"YOUR_KIDS_ROOM_DEVICE_ID","label":"儿童房空调"}]
# Legacy one-unit fallback (used only when MAC_EDGE_HISENSE_DEVICES is unset):
# MAC_EDGE_HISENSE_DEVICE_ID=
# MAC_EDGE_HISENSE_LABEL=客厅空调

# --- 米家 / Xiaomi (laptop；鱼缸 aquarium.set + 门锁 lock.status) ---
# Advertised only when both username and password are set. Never commit real values.
# Login may prompt captcha; sign in on 米家 App first if cloud rejects.
# MAC_EDGE_XIAOMI_USERNAME=
# MAC_EDGE_XIAOMI_PASSWORD=
# MAC_EDGE_XIAOMI_COUNTRY=cn
# MAC_EDGE_XIAOMI_AQUARIUM_DID=        # optional; required if more than one fish tank
# MAC_EDGE_XIAOMI_LOCK_DID=            # optional; required if more than one lock

# --- local.printer / printer.print (CUPS on home Wi-Fi; no SoftAP / no Xiaomi cloud) ---
# Optional CUPS queue name. If unset, auto-match queues containing Mi_All_in_One_Inkjet
# (e.g. Mi_All_in_One_Inkjet_Printer__1EB808_).
# MAC_EDGE_PRINTER_NAME=Mi_All_in_One_Inkjet_Printer__1EB808_
# lock.status is read-only — never remote unlock.

# --- 小米电视 S Pro display.photo via DLNA (replaces Cast on this laptop) ---
# MAC_EDGE_DISPLAY_BACKEND=xiaomi      # or cast
# MAC_EDGE_XIAOMI_TV=1
# MAC_EDGE_XIAOMI_TV_HOST=192.168.3.x
# MAC_EDGE_XIAOMI_TV_NAME=S Pro

# --- gopro.camera / camera.capture (silent Wi-Fi switch) ---
# Advertised only when MAC_EDGE_GOPRO_SSID is set (home-server). Leave unset on laptops.
# MAC_EDGE_GOPRO_SSID=GoProHero4xxxxx
# MAC_EDGE_GOPRO_PASSWORD=xxxxxxxx
# MAC_EDGE_WIFI_DEVICE=en0              # optional; auto-detect Wi-Fi port
# MAC_EDGE_HOME_WIFI_SSID=              # optional; default = SSID before join
# MAC_EDGE_HOME_WIFI_PASSWORD=          # optional if home net already preferred
# Hold after restore in case macOS auto-joins the GoPro AP (preferred-network bounce). Default 1s.
# MAC_EDGE_WIFI_HOLD_SEC=1
# Faster restore: System Settings → Wi-Fi → Known Networks → GoPro SSID → Auto-Join Off.
# MAC_EDGE_GOPRO_HOST=http://10.5.5.9
# MAC_EDGE_PHOTO_UPLOAD_URL=http://127.0.0.1:9527/api/v1/photos/upload
# MAC_EDGE_PHOTO_PUBLIC_BASE=http://115.190.153.53:8080
# Upload dest for camera.capture: lan (default) | cloud
# MAC_EDGE_PHOTO_UPLOAD_DEST=lan
# LAN img-server (this Mac :8080, code in repo img-server/)
# MAC_EDGE_LAN_PHOTO_UPLOAD_URL=http://127.0.0.1:8080/api/v1/photos/upload
# MAC_EDGE_LAN_PHOTO_PUBLIC_BASE=http://192.168.3.84:8080

# --- mac_voice / voice.stream (hosted under Mac Runtime; default on for laptop) ---
# MAC_EDGE_VOICE=0   # disable advertise + supervise (no Mac mic POST /intent)
# MAC_EDGE_VOICE=1   # force on
# --- mac_voice STT (USB mic → text → POST /intent when voice enabled) ---
# Separate participant from Runtime living-room-mac.
# MAC_VOICE_BRAIN_URL=http://127.0.0.1:9527
# MAC_VOICE_CLIENT_HINT=living-room-mac-mic
# MAC_VOICE_DISPLAY_NAME=客厅 · Mac USB 麦
# MAC_VOICE_STT_PROVIDER=volc_sauc
# MAC_VOICE_SAUC_API_KEY=
# MAC_VOICE_SAUC_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
# MAC_VOICE_SAUC_RESOURCE_ID=volc.seedasr.sauc.duration
# # Legacy auth instead of API key:
# # MAC_VOICE_SAUC_APP_KEY=
# # MAC_VOICE_SAUC_ACCESS_KEY=
# Continuous mic (quote names with spaces when shell-sourcing .env)
# MAC_VOICE_INPUT_DEVICE="reSpeaker XVF3800 4-Mic Array"
# Silence floor (stay in an utterance). Opening a clip needs ~3× this so HVAC/rumble never queues.
# If speech is missed, lower this (try 200–300); if ambient still queues, leave it at 500.
# MAC_VOICE_ENERGY_THRESHOLD=500
# Pause < 1s stays in the same sentence for *commands* after wake ack.
# MAC_VOICE_SILENCE_MS=1000
# USB wake hunt uses a shorter cut (default 400ms) so 「面条面条→我在呢」更快；
# 指令句开口后仍回落到 SILENCE_MS。
# MAC_VOICE_USB_WAKE_SILENCE_MS=400
# MAC_VOICE_USB_WAKE_MAX_SPEECH_MS=2800
# MAC_VOICE_MIN_SPEECH_MS=400
# MAC_VOICE_MAX_SPEECH_MS=8000
# Wake word (default): two 面条 tokens wake; next sentence within 5s after 又咋了 finishes is the command. always_on = no gate.
# MAC_VOICE_LISTEN_MODE=wake_word
# MAC_VOICE_WAKE_SCOPE=participant
# MAC_VOICE_WAKE_WORD=面条
# MAC_VOICE_WAKE_REPEAT=2
# MAC_VOICE_WAKE_ALIASES=miantiao,棉条,面跳,免条
# MAC_VOICE_COMMAND_WINDOW_MS=5000
# Home Mic: after「我在呢」, wait up to COMMAND_WINDOW for speech onset; then
# keep one utterance while gaps < PHONE_COMMAND_SILENCE_MS (default 1.5s), up to
# PHONE_COMMAND_MAX_SPEECH_MS (default 12s). Wake-word cuts stay shorter.
# MAC_VOICE_PHONE_WAKE_SILENCE_MS=350
# MAC_VOICE_PHONE_WAKE_MAX_SPEECH_MS=2800
# MAC_VOICE_PHONE_COMMAND_SILENCE_MS=1500
# MAC_VOICE_PHONE_COMMAND_MAX_SPEECH_MS=12000
# MAC_VOICE_PARTIAL_WAKE_MS=2500
# If STT collapses 面条面条 into one 面条, a ≥1.1s utterance that is only the wake word still counts as two.
# MAC_VOICE_DOUBLE_WAKE_MS=1100
# MAC_VOICE_WAKE_ACK=我在呢
# 识曲命令（打开识曲模式 / 这是什么歌）开录前的本地确认语；0 关闭
# MAC_VOICE_RECOGNIZE_ACK=好，开始识曲，我最多听 30 秒
# MAC_VOICE_RECOGNIZE_ACK_ENABLED=1
# 放歌时空闲片是否送火山 STT（改后重启 mac_voice）：all | skip_long（默认）| none
# MAC_VOICE_MUSIC_IDLE_STT=skip_long
# MAC_VOICE_MUSIC_IDLE_STT_MAX_MS=2500   # skip_long：超过此时长或顶满 MAX_SPEECH_MS 则跳过
# STT 输入 wav：默认系统临时目录、认句后删除。固定目录便于排查：
# MAC_VOICE_STT_WAV_DIR=default          # → mac/data/mac_voice/stt_wav
# # MAC_VOICE_STT_WAV_DIR=/path/to/wavs
# MAC_VOICE_STT_WAV_KEEP=0               # 1=认句后保留；仍受下面策略裁剪
# MAC_VOICE_STT_WAV_MAX_AGE_HOURS=24     # 0=不按年龄删
# MAC_VOICE_STT_WAV_MAX_FILES=100        # 0=不按个数删
# MAC_VOICE_STT_WAV_MAX_MB=200           # 0=不按总大小删

# --- Runtime intranet ping monitor (not a Brain capability; default ON) ---
# MAC_EDGE_INTRANET_PING=1
# MAC_EDGE_INTRANET_PING_MODE=gateway   # gateway | targets | lan
# MAC_EDGE_INTRANET_PING_TARGETS=192.168.3.65,192.168.3.8   # required when mode=targets
# MAC_EDGE_INTRANET_PING_INTERVAL_SEC=5
# MAC_EDGE_INTRANET_PING_TIMEOUT_MS=1000
# MAC_EDGE_INTRANET_PING_DISCOVER_INTERVAL_SEC=300   # lan peer refresh
# MAC_EDGE_INTRANET_PING_STATS_INTERVAL_SEC=60
# MAC_EDGE_INTRANET_PING_LOG=/path/to/intranet_ping.log

# --- 识曲（听歌识曲）music.recognize ---
# 无密钥时保持 none（不向 Brain 广告能力）；设 mock 可本机跑通全链路自测。
# MAC_EDGE_MUSIC_RECOGNIZE_PROVIDER=none   # none | mock | audd | acrcloud | shazam
# MAC_EDGE_MUSIC_RECOGNIZE_MIN_SEC=5        # 最短收录/首次识曲窗口（默认 5s，更快出结果）
# MAC_EDGE_MUSIC_RECOGNIZE_MAX_SEC=30       # 硬上限，超时自动退出
# MAC_EDGE_MUSIC_RECOGNIZE_RETRY_EVERY_SEC=3
# 采集输入设备：缺省跟随 MAC_VOICE_INPUT_DEVICE（客厅 USB 麦）
# # MAC_EDGE_MUSIC_RECOGNIZE_INPUT_DEVICE="reSpeaker XVF3800 4-Mic Array"
# 调试保留录音（可选）：
# # MAC_EDGE_MUSIC_RECOGNIZE_WAV_KEEP=1
# # 默认目录：$MAC_EDGE_DATA_DIR/music_recognize/wav（例：mac/data/music_recognize/wav）
# # MAC_EDGE_MUSIC_RECOGNIZE_WAV_DIR=/path/to/recognize_wavs
# --- Provider 密钥（占位；拿到哪个填哪个，设对应 PROVIDER 即启用） ---
# # MAC_EDGE_MUSIC_RECOGNIZE_AUDD_TOKEN=your_audd_api_token
# # MAC_EDGE_MUSIC_RECOGNIZE_ACR_ACCESS_KEY=your_access_key
# # MAC_EDGE_MUSIC_RECOGNIZE_ACR_ACCESS_SECRET=your_access_secret
# # MAC_EDGE_MUSIC_RECOGNIZE_ACR_HOST=identify-ap-southeast-1.acrcloud.com
# # MAC_EDGE_MUSIC_RECOGNIZE_SHAZAM_KEY=your_rapidapi_key
# # MAC_EDGE_MUSIC_RECOGNIZE_SHAZAM_HOST=shazam-api6.p.rapidapi.com
# 弱信号门限（低于此 RMS 视为没声音，跳过 Provider 省配额），默认 200
# # MAC_EDGE_MUSIC_RECOGNIZE_SIGNAL_THRESHOLD=200

